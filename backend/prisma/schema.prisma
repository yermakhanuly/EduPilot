generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                 String              @id @default(uuid())
  email              String              @unique
  name               String
  passwordHash       String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  tasks              Task[]
  studyBlocks        StudyBlock[]
  studySessions      StudySession[]
  rewards            Reward[]
  stats              UserStats?
  integrationCanvas  IntegrationCanvas?
  courses            Course[]
  weeklyClasses      WeeklyClass[]
  fixedEvents        FixedEvent[]
  knowledgeDocuments KnowledgeDocument[]
  conversations      Conversation[]
}

model Task {
  id                  String         @id @default(uuid())
  userId              String
  title               String
  description         String?
  deadline            DateTime?
  difficulty          String         @default("medium")
  priority            Int            @default(1)
  remainingHours      Int            @default(0)
  status              String         @default("pending")
  source              String         @default("manual")
  externalId          String?
  completedAt         DateTime?
  completionXpAwarded Boolean        @default(false)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  studyBlocks         StudyBlock[]
  studySessions       StudySession[]
}

model StudyBlock {
  id           String        @id @default(uuid())
  userId       String
  taskId       String?
  start        DateTime
  end          DateTime
  source       String        @default("planner")
  status       String        @default("scheduled")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  task         Task?         @relation(fields: [taskId], references: [id], onDelete: SetNull)
  studySession StudySession? @relation("BlockSession")
}

model StudySession {
  id             String      @id @default(uuid())
  userId         String
  taskId         String?
  blockId        String?     @unique
  startedAt      DateTime    @default(now())
  endedAt        DateTime?
  status         String      @default("in-progress")
  focusedMinutes Int         @default(0)
  xpEarned       Int         @default(0)
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  task           Task?       @relation(fields: [taskId], references: [id], onDelete: SetNull)
  block          StudyBlock? @relation("BlockSession", fields: [blockId], references: [id], onDelete: SetNull)
}

model Reward {
  id        String    @id @default(uuid())
  userId    String
  label     String
  detail    String?
  costXp    Int       @default(0)
  claimedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserStats {
  id            String    @id @default(uuid())
  userId        String    @unique
  totalXp       Int       @default(0)
  weeklyXp      Int       @default(0)
  streak        Int       @default(0)
  level         Int       @default(1)
  dailyBaseXp   Int       @default(0)
  dailyXp       Int       @default(0)
  dailyDate     DateTime?
  lastSessionAt DateTime?
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model IntegrationCanvas {
  id             String    @id @default(uuid())
  userId         String    @unique
  tokenEncrypted String?
  canvasBaseUrl  String
  canvasUserId   String?
  lastImportedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Course {
  id             String              @id @default(uuid())
  userId         String
  canvasCourseId String?
  name           String
  courseCode     String?
  source         String              @default("canvas")
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents      KnowledgeDocument[]
  conversations  Conversation[]

  @@unique([userId, canvasCourseId])
  @@index([userId])
}

model KnowledgeDocument {
  id           String   @id @default(uuid())
  userId       String
  courseId     String?
  sourceType   String
  sourceId     String?
  title        String
  mimeType     String?
  checksum     String
  status       String   @default("pending")
  errorMessage String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course       Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, sourceType, sourceId])
  @@index([userId, courseId])
}

model Conversation {
  id           String        @id @default(uuid())
  userId       String
  courseId     String?
  title        String        @default("New chat")
  activeBranch String        @default("main")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  course       Course?       @relation(fields: [courseId], references: [id], onDelete: SetNull)
  messages     ChatMessage[]

  @@index([userId, updatedAt])
  @@index([userId, courseId])
}

model ChatMessage {
  id              String        @id @default(uuid())
  conversationId  String
  parentMessageId String?
  branchId        String        @default("main")
  role            String
  content         String
  sources         Json?
  actions         Json?
  status          String        @default("complete")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  conversation    Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  parentMessage   ChatMessage?  @relation("MessageBranch", fields: [parentMessageId], references: [id], onDelete: SetNull)
  childMessages   ChatMessage[] @relation("MessageBranch")

  @@index([conversationId, branchId, createdAt])
  @@index([parentMessageId])
}

model FixedEvent {
  id         String   @id @default(uuid())
  userId     String
  title      String
  type       String   @default("exam")
  start      DateTime
  end        DateTime
  notes      String?
  source     String   @default("manual")
  externalId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WeeklyClass {
  id         String   @id @default(uuid())
  userId     String
  title      String
  day        Int
  start      String
  end        String
  location   String?
  source     String   @default("manual")
  externalId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
